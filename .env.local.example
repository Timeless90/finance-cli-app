# Optional native backend settings; export explicitly or use ApiSettings(_env_file=...).
# Root .env.local is preserved but no longer automatically loaded.
CFO_ENVIRONMENT=development
CFO_GOVERNANCE_DATABASE_URL=postgresql://template:template-local@127.0.0.1:15432/template
# Relative to the backend working directory:
CFO_IMPORT_STORAGE_PATH=../.local/migrated/imports
CFO_RATE_LIMIT_REQUESTS_PER_MINUTE=0
# Explicit demonstration mode only (used by isolated UAT):
# CFO_FOUNDRY_MODE=echo
