{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "type": "stdio",
      "command": "mise",
      "cwd": "${workspaceFolder}",
      "args": [
        "exec",
        "--",
        "pnpm",
        "--dir",
        "${workspaceFolder}/frontend",
        "exec",
        "mcp-server-playwright",
        "--isolated",
        "--headless",
        "--output-dir",
        "${workspaceFolder}/.local/playwright-mcp"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${input:twenty-first-api-key}"
      }
    },
    "microsoftLearn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "shadcn": {
      "type": "stdio",
      "command": "mise",
      "cwd": "${workspaceFolder}/frontend",
      "args": [
        "exec",
        "--",
        "pnpm",
        "dlx",
        "shadcn@4.21.0",
        "mcp"
      ]
    },
    "grafana": {
      "type": "stdio",
      "command": "mise",
      "cwd": "${workspaceFolder}",
      "args": [
        "exec",
        "--",
        "uv",
        "tool",
        "run",
        "--from",
        "mcp-grafana==1.3.0",
        "mcp-grafana",
        "--transport",
        "stdio",
        "--disable-write",
        "--enabled-tools",
        "search,datasource,dashboard,prometheus,loki"
      ],
      "env": {
        "GRAFANA_URL": "http://127.0.0.1:3000",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${input:grafana-viewer-token}"
      }
    },
    "postgres": {
      "type": "stdio",
      "command": "mise",
      "cwd": "${workspaceFolder}/.vscode/mcp",
      "args": [
        "exec",
        "--",
        "pnpm",
        "dlx",
        "@bytebase/dbhub@1.2.3",
        "--transport",
        "stdio",
        "--config",
        "${workspaceFolder}/.vscode/mcp/dbhub.toml"
      ],
      "env": {
        "MCP_POSTGRES_DSN": "${input:postgres-readonly-dsn}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "twenty-first-api-key",
      "description": "21st API-Key (https://21st.dev/mcp)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "grafana-viewer-token",
      "description": "Token eines Grafana Service Accounts mit Viewer-Rolle (lokal: http://127.0.0.1:3000)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "postgres-readonly-dsn",
      "description": "PostgreSQL-Verbindungs-URI eines Benutzers mit Leserechten; lokale Vorlage: Port 15432, Datenbank template",
      "password": true
    }
  ]
}
