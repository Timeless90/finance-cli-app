{
  "name": "finance-cli-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:uat": "vite --host 127.0.0.1 --port 5173 --strictPort --mode uat",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort --mode devlocal",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:export": "uv run --project ../backend python ../scripts/export_openapi.py",
    "api:generate": "orval --config orval.config.ts && uv run --project ../backend python ../scripts/generate_api_dispatch.py && prettier --write src/generated",
    "api:sync": "pnpm api:export && pnpm api:generate",
    "mock:init": "msw init public --save",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "@tanstack/react-router": "^1.131.35",
    "zustand": "^5.0.8",
    "react-hook-form": "^7.62.0",
    "zod": "4.4.3",
    "@hookform/resolvers": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "msw": "^2.0.0",
    "prettier": "3.6.2",
    "storybook": "^10.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/mcp": "^0.0.40",
    "orval": "^7.11.2"
  },
  "packageManager": "pnpm@10.15.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}