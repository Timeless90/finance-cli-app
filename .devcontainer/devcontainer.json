{
  "name": "CFO Command Center",
  "remoteUser": "vscode",
  "forwardPorts": [
    5173,
    8000,
    3000
  ],
  "postCreateCommand": "mise trust --yes && mise install && mise exec -- make install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "ms-playwright.playwright"
      ]
    }
  },
  "dockerComposeFile": [
    "../compose.yml",
    "../compose.devcontainer.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspaces/template",
  "shutdownAction": "stopCompose"
}
